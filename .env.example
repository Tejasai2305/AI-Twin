# =============================================================
# AI-Twin - Environment Variables
# =============================================================
# Copy this file to .env and fill in real values.
# Never commit the real .env file - it's already in .gitignore.

# -------------------------------------------------------------
# Required: AI model + tools
# -------------------------------------------------------------
GEMINI_API_KEY=
TAVILY_API_KEY=

# -------------------------------------------------------------
# Authentication
# -------------------------------------------------------------
# Secret used to sign login sessions (JWTs). REQUIRED in production -
# the app falls back to an insecure development-only default if this
# is unset, which must never be used outside local development.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# How long a login session stays valid, in minutes. Defaults to 43200
# (30 days) if unset.
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# -------------------------------------------------------------
# Database
# -------------------------------------------------------------
# Leave unset for local development: the app uses a local SQLite file
# (AI_TWIN_DATA_DIR/notes.db) automatically, no setup needed.
#
# For production, set to a PostgreSQL connection string and the app
# switches drivers automatically - see backend/database/config.py
# and backend/database/pg_compat.py.
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Where local data (SQLite file, FAISS indexes, uploaded documents)
# is stored. Defaults to the project root if unset.
AI_TWIN_DATA_DIR=

# -------------------------------------------------------------
# CORS
# -------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Leave unset to use the built-in local-dev + default deployment
# origins (see backend/main.py). Set explicitly in production to
# your actual frontend domain(s).
#   CORS_ORIGINS=https://your-frontend.example.com,https://staging.example.com
CORS_ORIGINS=
